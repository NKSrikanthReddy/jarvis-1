# ==============================================================================
# JARVIS Personal Assistant - Environment Configuration
# ==============================================================================

# User Addressing
JARVIS_USER_NAME=Sir

# ------------------------------------------------------------------------------
# Google Gemini LLM Configuration
# ------------------------------------------------------------------------------
# Get your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# ------------------------------------------------------------------------------
# Email Backend 1: Gmail API (OAuth 2.0)
# ------------------------------------------------------------------------------
# Place your credentials.json downloaded from Google Cloud Console in the project root
GMAIL_CREDENTIALS_PATH=credentials.json
GMAIL_TOKEN_PATH=token.json

# ------------------------------------------------------------------------------
# Email Backend 2: IMAP Fallback (Gmail App Password)
# ------------------------------------------------------------------------------
# If you prefer IMAP or as a fallback:
# 1. Enable 2-Step Verification on your Google Account
# 2. Generate an App Password at: https://myaccount.google.com/apppasswords
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=your_16_char_app_password
IMAP_SERVER=imap.gmail.com
IMAP_PORT=993
IMAP_FOLDER=INBOX

# ------------------------------------------------------------------------------
# Operational & Voice Defaults
# ------------------------------------------------------------------------------
DEFAULT_EMAIL_LIMIT=5
CHECK_INTERVAL_SECONDS=300
ENABLE_VOICE=false
VOICE_RATE=185
